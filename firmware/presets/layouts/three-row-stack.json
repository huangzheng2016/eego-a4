{
  "schema": "eego.dashboard-preset/1",
  "schema_version": 1,
  "id": "three-row-stack",
  "kind": "layout",
  "title": "Three-row information stack",
  "description": "Summary, trend, and table in three horizontal bands.",
  "dashboard": {
    "sources": [
      {
        "id": "metrics",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/metrics",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "panels": [
          {
            "id": "summary",
            "kind": "text",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 2
            },
            "title": "Summary",
            "visible": true,
            "refresh_ms": 60000,
            "text": {
              "content": "Three-row information stack",
              "multiline": true,
              "max_lines": 2
            },
            "style": {
              "variant": "description"
            }
          },
          {
            "id": "trend",
            "kind": "chart",
            "grid": {
              "x": 0,
              "y": 2,
              "w": 24,
              "h": 3
            },
            "title": "Trend",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "series.value",
            "chart": {
              "kind": "line",
              "show_points": false,
              "fill": false,
              "y_min": null,
              "y_max": null
            },
            "style": {
              "unit": "",
              "precision": 1,
              "line_width": 2,
              "show_legend": true
            },
            "time_window": {
              "from": "-1h",
              "to": "now"
            }
          },
          {
            "id": "details",
            "kind": "table",
            "grid": {
              "x": 0,
              "y": 5,
              "w": 24,
              "h": 3
            },
            "title": "Details",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "table.value",
            "columns": [
              {
                "key": "name",
                "title": "Name",
                "width": 8
              },
              {
                "key": "value",
                "title": "Value",
                "width": 5
              }
            ],
            "style": {
              "variant": "default",
              "precision": 1
            }
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "metrics",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/metrics",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
