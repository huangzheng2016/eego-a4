{
  "schema": "eego.dashboard-preset/1",
  "schema_version": 1,
  "id": "mosaic",
  "kind": "layout",
  "title": "Mosaic",
  "description": "Six mixed panels using metrics, events, text, and image sources.",
  "dashboard": {
    "sources": [
      {
        "id": "metrics",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/metrics",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      },
      {
        "id": "events",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/events",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      },
      {
        "id": "text",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/text",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      },
      {
        "id": "image",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/assets/status.png",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "row_height": 16,
        "panels": [
          {
            "id": "trend",
            "kind": "chart",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 12,
              "h": 5
            },
            "title": "Trend",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "series.value",
            "chart": {
              "kind": "line",
              "show_points": false,
              "fill": false,
              "y_min": null,
              "y_max": null
            },
            "style": {
              "unit": "",
              "precision": 1,
              "line_width": 2,
              "show_legend": true
            },
            "time_window": {
              "from": "-1h",
              "to": "now"
            }
          },
          {
            "id": "value",
            "kind": "card",
            "grid": {
              "x": 18,
              "y": 0,
              "w": 6,
              "h": 3
            },
            "title": "Value",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "metric.value",
            "style": {
              "variant": "default",
              "precision": 1
            }
          },
          {
            "id": "mosaic_image",
            "kind": "image",
            "grid": {
              "x": 12,
              "y": 0,
              "w": 6,
              "h": 3
            },
            "title": "Image",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "image",
            "metric": "image",
            "image": {
              "asset_id": "status_image",
              "alt_text": "No image",
              "fit": "contain"
            }
          },
          {
            "id": "notes",
            "kind": "text",
            "grid": {
              "x": 12,
              "y": 3,
              "w": 12,
              "h": 2
            },
            "title": "Notes",
            "visible": true,
            "refresh_ms": 60000,
            "text": {
              "content": "Loading notes…",
              "multiline": true,
              "max_lines": 3
            },
            "style": {
              "variant": "multiline"
            },
            "source_id": "text",
            "metric": "text"
          },
          {
            "id": "records",
            "kind": "table",
            "grid": {
              "x": 0,
              "y": 5,
              "w": 12,
              "h": 3
            },
            "title": "Records",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "table.value",
            "columns": [
              {
                "key": "name",
                "title": "Name",
                "width": 8
              },
              {
                "key": "value",
                "title": "Value",
                "width": 5
              }
            ],
            "style": {
              "variant": "default",
              "precision": 1
            }
          },
          {
            "id": "alerts",
            "kind": "alert",
            "grid": {
              "x": 12,
              "y": 5,
              "w": 12,
              "h": 3
            },
            "title": "Alerts",
            "visible": true,
            "refresh_ms": 60000,
            "text": {
              "content": "No alerts",
              "multiline": false,
              "max_lines": 1
            }
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [
      {
        "id": "status_image",
        "kind": "image",
        "uri": "http://${mock_host}/assets/status.png",
        "media_type": "image/png",
        "sha256": "",
        "size_bytes": 0,
        "cache_seconds": 300
      }
    ],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "metrics",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/metrics",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    },
    {
      "id": "events",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/events",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    },
    {
      "id": "text",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/text",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "text",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    },
    {
      "id": "image",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/assets/status.png",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "image",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
