{
  "schema": "eego.dashboard-preset/1",
  "schema_version": 1,
  "id": "kpi-2x2",
  "kind": "layout",
  "title": "2x2 KPI",
  "description": "Four independent KPI cards in a two-by-two grid.",
  "dashboard": {
    "sources": [
      {
        "id": "metrics",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/metrics",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "panels": [
          {
            "id": "kpi_a",
            "kind": "card",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 12,
              "h": 4
            },
            "title": "KPI A",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "metric.value",
            "style": {
              "variant": "default",
              "precision": 1
            }
          },
          {
            "id": "kpi_b",
            "kind": "card",
            "grid": {
              "x": 12,
              "y": 0,
              "w": 12,
              "h": 4
            },
            "title": "KPI B",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "metric.secondary",
            "style": {
              "variant": "default",
              "precision": 1
            }
          },
          {
            "id": "kpi_c",
            "kind": "card",
            "grid": {
              "x": 0,
              "y": 4,
              "w": 12,
              "h": 4
            },
            "title": "KPI C",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "metric.tertiary",
            "style": {
              "variant": "default",
              "precision": 1
            }
          },
          {
            "id": "kpi_d",
            "kind": "card",
            "grid": {
              "x": 12,
              "y": 4,
              "w": 12,
              "h": 4
            },
            "title": "Progress",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "progress.percent",
            "style": {
              "variant": "progress",
              "precision": 0,
              "unit": "%"
            }
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "metrics",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/metrics",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
