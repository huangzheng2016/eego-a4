{
  "schema": "eego.dashboard-preset/1",
  "schema_version": 1,
  "id": "chart-alerts",
  "kind": "layout",
  "title": "Chart + alerts",
  "description": "Trend and alert stream side by side.",
  "dashboard": {
    "sources": [
      {
        "id": "metrics",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/metrics",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      },
      {
        "id": "events",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/events",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "row_height": 16,
        "panels": [
          {
            "id": "trend",
            "kind": "chart",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 16,
              "h": 8
            },
            "title": "Trend",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "series.value",
            "chart": {
              "kind": "line",
              "show_points": false,
              "fill": false,
              "y_min": null,
              "y_max": null
            },
            "style": {
              "unit": "",
              "precision": 1,
              "line_width": 2,
              "show_legend": true
            },
            "time_window": {
              "from": "-1h",
              "to": "now"
            }
          },
          {
            "id": "alerts",
            "kind": "alert",
            "grid": {
              "x": 16,
              "y": 0,
              "w": 8,
              "h": 8
            },
            "title": "Alerts",
            "visible": true,
            "refresh_ms": 60000,
            "text": {
              "content": "No alerts",
              "multiline": false,
              "max_lines": 1
            }
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "metrics",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/metrics",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    },
    {
      "id": "events",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/events",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
