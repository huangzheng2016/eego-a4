{
  "schema": "eego.dashboard-bundle/1",
  "schema_version": 1,
  "revision": 0,
  "dashboard": {
    "schema": "eego.dashboard/2",
    "schema_version": 2,
    "id": "security-events",
    "title": "Network security events",
    "default_page_id": "main",
    "refresh_ms": 60000,
    "sources": [
      {
        "id": "security",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/security",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "row_height": 16,
        "panels": [
          {
            "id": "active_alerts",
            "kind": "card",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 8,
              "h": 3
            },
            "title": "Active alerts",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "security",
            "metric": "security.alerts.active",
            "style": {
              "variant": "default",
              "precision": 0
            },
            "thresholds": [
              {
                "value": 1,
                "severity": "warning",
                "label": "Active"
              },
              {
                "value": 5,
                "severity": "critical",
                "label": "High"
              }
            ]
          },
          {
            "id": "blocked",
            "kind": "card",
            "grid": {
              "x": 8,
              "y": 0,
              "w": 8,
              "h": 3
            },
            "title": "Blocked",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "security",
            "metric": "security.blocked",
            "style": {
              "variant": "default",
              "precision": 0
            }
          },
          {
            "id": "failed_logins",
            "kind": "card",
            "grid": {
              "x": 16,
              "y": 0,
              "w": 8,
              "h": 3
            },
            "title": "Failed logins",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "security",
            "metric": "security.failed_logins",
            "style": {
              "variant": "default",
              "precision": 0
            }
          },
          {
            "id": "security_events",
            "kind": "alert",
            "grid": {
              "x": 0,
              "y": 3,
              "w": 24,
              "h": 4
            },
            "title": "Network security events",
            "visible": true,
            "refresh_ms": 60000,
            "text": {
              "content": "No alerts",
              "multiline": false,
              "max_lines": 1
            }
          },
          {
            "id": "security_actions",
            "kind": "button",
            "grid": {
              "x": 0,
              "y": 7,
              "w": 24,
              "h": 1
            },
            "title": "Actions",
            "visible": true,
            "refresh_ms": 60000,
            "actions": [
              {
                "id": "refresh",
                "kind": "refresh",
                "label": "Refresh",
                "target": "security",
                "value": "",
                "confirm": false
              },
              {
                "id": "ack",
                "kind": "ack_alert",
                "label": "Ack current",
                "target": "current",
                "value": "",
                "confirm": true
              }
            ]
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "security",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/security",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
