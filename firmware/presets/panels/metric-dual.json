{
  "schema": "eego.dashboard-preset/1",
  "schema_version": 1,
  "id": "metric-dual",
  "kind": "panel",
  "title": "Dual metric",
  "description": "One dual card with a linked independent metric series.",
  "dashboard": {
    "sources": [
      {
        "id": "metrics",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/metrics",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "panels": [
          {
            "id": "primary_value",
            "kind": "card",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 8
            },
            "title": "Two metrics",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "metric.value",
            "style": {
              "variant": "dual",
              "precision": 1
            },
            "linked_panel_ids": [
              "secondary_value"
            ]
          },
          {
            "id": "secondary_value",
            "kind": "card",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 1,
              "h": 1
            },
            "title": "Secondary",
            "visible": false,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "metric.secondary",
            "style": {
              "variant": "default",
              "precision": 1
            }
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "metrics",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/metrics",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
