{
  "schema": "eego.dashboard-preset/1",
  "schema_version": 1,
  "id": "timeline",
  "kind": "panel",
  "title": "Timeline",
  "description": "Up to 16 timestamped states on a horizontal timeline.",
  "dashboard": {
    "sources": [
      {
        "id": "metrics",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/metrics",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "row_height": 16,
        "panels": [
          {
            "id": "timeline",
            "kind": "table",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 8
            },
            "title": "Timeline",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "metrics",
            "metric": "timeline.value",
            "columns": [
              {
                "key": "name",
                "title": "Name",
                "width": 8
              },
              {
                "key": "value",
                "title": "Value",
                "width": 5
              }
            ],
            "style": {
              "variant": "timeline",
              "precision": 1
            },
            "thresholds": [
              {
                "value": 1,
                "severity": "warning",
                "label": "Degraded"
              },
              {
                "value": 2,
                "severity": "critical",
                "label": "Down"
              }
            ]
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "metrics",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/metrics",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
