{
  "schema": "eego.dashboard-preset/1",
  "schema_version": 1,
  "id": "button-group",
  "kind": "panel",
  "title": "Button group",
  "description": "Refresh, navigation, variable, and confirmed alert acknowledgement actions.",
  "dashboard": {
    "sources": [
      {
        "id": "metrics",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/metrics",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      },
      {
        "id": "events",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/events",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      },
      {
        "name": "view",
        "label": "View",
        "kind": "constant",
        "default_value": "compact",
        "options": [
          {
            "label": "Compact",
            "value": "compact"
          },
          {
            "label": "Detailed",
            "value": "detailed"
          }
        ],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "panels": [
          {
            "id": "button_group",
            "kind": "button",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 8
            },
            "title": "Actions / ${view}",
            "visible": true,
            "refresh_ms": 60000,
            "actions": [
              {
                "id": "refresh",
                "kind": "refresh",
                "label": "Refresh",
                "target": "metrics",
                "value": "",
                "confirm": false
              },
              {
                "id": "details",
                "kind": "goto_page",
                "label": "Events",
                "target": "details",
                "value": "",
                "confirm": false
              },
              {
                "id": "detailed",
                "kind": "set_variable",
                "label": "Detailed",
                "target": "view",
                "value": "detailed",
                "confirm": false
              },
              {
                "id": "ack",
                "kind": "ack_alert",
                "label": "Ack current",
                "target": "current",
                "value": "",
                "confirm": true
              }
            ]
          }
        ]
      },
      {
        "id": "details",
        "title": "Events",
        "visible": true,
        "grid_columns": 24,
        "panels": [
          {
            "id": "events",
            "kind": "alert",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 6
            },
            "title": "Events",
            "visible": true,
            "refresh_ms": 60000,
            "text": {
              "content": "No alerts",
              "multiline": false,
              "max_lines": 1
            }
          },
          {
            "id": "back",
            "kind": "button",
            "grid": {
              "x": 0,
              "y": 6,
              "w": 24,
              "h": 2
            },
            "title": "Back",
            "visible": true,
            "refresh_ms": 60000,
            "actions": [
              {
                "id": "back",
                "kind": "back",
                "label": "Back",
                "target": "",
                "value": "",
                "confirm": false
              }
            ]
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "metrics",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/metrics",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    },
    {
      "id": "events",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/events",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
