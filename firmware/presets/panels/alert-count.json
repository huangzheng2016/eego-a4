{
  "schema": "eego.dashboard-preset/1",
  "schema_version": 1,
  "id": "alert-count",
  "kind": "panel",
  "title": "Alert count",
  "description": "Large count from a generic alerts.active metric supplied by the source.",
  "dashboard": {
    "sources": [
      {
        "id": "events",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/events",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "panels": [
          {
            "id": "alert_count",
            "kind": "card",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 8
            },
            "title": "Active alerts",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "events",
            "metric": "alerts.active",
            "style": {
              "variant": "default",
              "precision": 0
            },
            "thresholds": [
              {
                "value": 1,
                "severity": "warning",
                "label": "Active"
              },
              {
                "value": 5,
                "severity": "critical",
                "label": "High"
              }
            ]
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "events",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/events",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
