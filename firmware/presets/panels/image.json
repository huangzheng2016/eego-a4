{
  "schema": "eego.dashboard-preset/1",
  "schema_version": 1,
  "id": "image",
  "kind": "panel",
  "title": "Image",
  "description": "PNG image fetched through the existing asset/source pipeline.",
  "dashboard": {
    "sources": [
      {
        "id": "image",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/assets/status.png",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "panels": [
          {
            "id": "status_image_panel",
            "kind": "image",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 8
            },
            "title": "Image",
            "visible": true,
            "refresh_ms": 60000,
            "source_id": "image",
            "metric": "image",
            "image": {
              "asset_id": "status_image",
              "alt_text": "Status image unavailable",
              "fit": "contain"
            }
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [
      {
        "id": "status_image",
        "kind": "image",
        "uri": "http://${mock_host}/assets/status.png",
        "media_type": "image/png",
        "sha256": "",
        "size_bytes": 0,
        "cache_seconds": 300
      }
    ],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "image",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/assets/status.png",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "image",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
