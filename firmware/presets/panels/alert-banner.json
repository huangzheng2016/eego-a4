{
  "schema": "eego.dashboard-preset/1",
  "schema_version": 1,
  "id": "alert-banner",
  "kind": "panel",
  "title": "Alert banner",
  "description": "Two-row alert surface for the newest active events.",
  "dashboard": {
    "sources": [
      {
        "id": "events",
        "kind": "http",
        "enabled": true,
        "url": "http://${mock_host}/events",
        "refresh_ms": 60000,
        "timeout_ms": 10000,
        "max_response_bytes": 65536,
        "tls_verify": true,
        "auth_token_ref": "",
        "headers": {}
      }
    ],
    "variables": [
      {
        "name": "mock_host",
        "label": "Mock host:port",
        "kind": "text",
        "default_value": "127.0.0.1:8978",
        "options": [],
        "source_id": "",
        "value_path": "",
        "multi": false,
        "include_all": false
      }
    ],
    "pages": [
      {
        "id": "main",
        "title": "Overview",
        "visible": true,
        "grid_columns": 24,
        "panels": [
          {
            "id": "alert_banner",
            "kind": "alert",
            "grid": {
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 2
            },
            "title": "Alert banner",
            "visible": true,
            "refresh_ms": 60000,
            "text": {
              "content": "All clear",
              "multiline": false,
              "max_lines": 1
            }
          },
          {
            "id": "banner_note",
            "kind": "text",
            "grid": {
              "x": 0,
              "y": 2,
              "w": 24,
              "h": 6
            },
            "title": "Banner semantics",
            "visible": true,
            "refresh_ms": 60000,
            "text": {
              "content": "The compact native alert panel shows the newest active event first.",
              "multiline": true,
              "max_lines": 4
            },
            "style": {
              "variant": "description"
            }
          }
        ]
      }
    ],
    "alert_rules": [],
    "assets": [],
    "samples": [],
    "events": []
  },
  "source_plans": [
    {
      "id": "events",
      "kind": "http",
      "enabled": true,
      "url": "http://${mock_host}/events",
      "refresh_ms": 60000,
      "timeout_ms": 10000,
      "max_response_bytes": 65536,
      "tls_verify": true,
      "auth_token_ref": "",
      "headers": {},
      "response": "standard_json",
      "method": "GET",
      "body": "",
      "static_body": "",
      "text_path": "",
      "reset_at_path": "$.reset_at",
      "stale_after_ms": 300000,
      "conditional_get": true,
      "max_json_depth": 16
    }
  ]
}
