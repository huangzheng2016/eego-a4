# EEGO A4 告警面板 ESP-IDF v5.5.1 默认配置
# 纯 ESP-IDF，无 Arduino 依赖
# 板级事实（PSRAM/WiFi 共存、栈大小、FATFS 长名）继承自已验证的阅读器固件经验，
# 其中 WiFi/TLS 条目为后续网络任务（net_task 独占 esp_http_client）预留。

# 目标芯片
CONFIG_IDF_TARGET="esp32s3"

# Flash: 16MB DIO 80MHz
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 分区表：自定义 16MB A/B OTA
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# PSRAM: Octal 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# PSRAM 只通过 heap_caps_malloc(MALLOC_CAP_SPIRAM) 显式分配，普通 malloc 不触碰 PSRAM
# （避免 WiFi/NVS 内部分配到 PSRAM 导致 flash 写崩溃）。
# 注意：SPIRAM_USE 是 Kconfig choice，必须显式选中成员；单独写
# "CONFIG_SPIRAM_USE_MALLOC is not set" 对 choice 无效（choice 默认值仍会选中 MALLOC，
# 参考实现 sdkconfig.defaults 即存在此潜伏问题，其固件实际以 MALLOC 模式运行）。
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# 不把 WiFi/LWIP 缓冲区放 PSRAM（会导致 WiFi 驱动内部崩溃）
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set

# FATFS: UTF-8 长名 + HEAP 模式（SD 卡中文文件名）
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_437=y
CONFIG_FATFS_MAX_LFN=255

# WiFi — 禁用 IRAM OP（与 PSRAM 冲突会导致 mgd_probe 崩溃）
# 禁用 WiFi NVS（ppTask 中 nvs_open 会触发 esp_partition_main_flash_region_safe 崩溃）
CONFIG_ESP_WIFI_ENABLED=y
# TX 功率固定 20dBm（法规上限）。运行时只在 start 后生效值被压低时用
# esp_wifi_set_max_tx_power(80)（单位 0.25dBm）恢复，并记录生效值（WifiManager）。
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=20
# 802.11k/v：mesh/多 AP 路由器的邻居报告与 BSS 切换建议（sta rm_enabled/btm_enabled）
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_RRM_SUPPORT=y
CONFIG_ESP_WIFI_WNM_SUPPORT=y
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# BLE-only NimBLE + WiFi 单射频软件共存。运行时角色默认全部关闭，按需 init/deinit。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_GATT_CLIENT is not set
# CONFIG_BT_NIMBLE_EXT_ADV is not set
# CONFIG_BT_NIMBLE_EXT_SCAN is not set
# CONFIG_BT_NIMBLE_ENABLE_PERIODIC_ADV is not set
# CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC is not set
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=16
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=24
CONFIG_BT_NIMBLE_HOST_QUEUE_CONG_CHECK=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SMP_ID_RESET=y
# CONFIG_BT_NIMBLE_PROX_SERVICE is not set
# CONFIG_BT_NIMBLE_ANS_SERVICE is not set
# CONFIG_BT_NIMBLE_CTS_SERVICE is not set
# CONFIG_BT_NIMBLE_HTP_SERVICE is not set
# CONFIG_BT_NIMBLE_IPSS_SERVICE is not set
# CONFIG_BT_NIMBLE_TPS_SERVICE is not set
# CONFIG_BT_NIMBLE_IAS_SERVICE is not set
# CONFIG_BT_NIMBLE_LLS_SERVICE is not set
# CONFIG_BT_NIMBLE_SPS_SERVICE is not set
# CONFIG_BT_NIMBLE_HR_SERVICE is not set
# CONFIG_BT_NIMBLE_BAS_SERVICE is not set
# CONFIG_BT_NIMBLE_DIS_SERVICE is not set
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
# CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0 is not set
# CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2 is not set

# HTTPS / TLS（后续 net_task 需要）
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# lwIP TCPIP 任务栈（sys_evt）：默认 3072 太小，DHCP 拿到 IP 时调用链深会溢出
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192

# 默认事件循环任务栈（esp_event）：事件回调里会做 SD/JSON 写入，
# 默认 2304+512 太小会栈溢出并踩坏相邻任务（表现为误报 sys_evt 溢出）
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192

# 主任务栈：后续 TLS 握手+证书校验调用链深，32KB 为已验证上限
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# 原生 USB Serial/JTAG 控制台（刷写与诊断共用）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# SPI master
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# I2C
CONFIG_I2C_ENABLE_DEBUG_LOG=n

# OTA 回滚保护
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
